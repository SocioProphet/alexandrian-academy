{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alexandrian-academy://schemas/constitutional-review-event.schema.json",
  "title": "ConstitutionalReviewEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "event_id", "review_layer", "case_ref", "trigger", "review_body_ref", "decision", "basis_refs", "status", "created_at"],
  "properties": {
    "header": {"$ref": "universal-header.schema.json"},
    "event_id": {"type": "string", "minLength": 8},
    "review_layer": {"type": "string", "const": "M3"},
    "case_ref": {"type": "string", "minLength": 3},
    "trigger": {"type": "string", "enum": ["appeal_high_impact_decision", "guild_capture_allegation", "m2_anomaly_cluster", "charter_conflict", "emergency_intervention_review", "model_or_scoring_drift", "systemic_false_positive_trend", "systemic_false_negative_trend"]},
    "review_body_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_id", "body_type"],
      "properties": {
        "body_id": {"type": "string", "minLength": 3},
        "body_type": {"type": "string", "enum": ["steward_panel", "senior_auditors", "constitutional_jury", "mixed_panel"]}
      }
    },
    "subject_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 3}
    },
    "target_event_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 3}
    },
    "bridge_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "learning_loop_record_ref": {"type": "string"},
        "learning_action_explanation_ref": {"type": "string"},
        "learning_search_record_ref": {"type": "string"},
        "learning_memory_record_ref": {"type": "string"},
        "oracle_evaluation_ref": {"type": "string"},
        "moirai_changeset_ref": {"type": "string"},
        "policy_parameter_snapshot_ref": {"type": "string"},
        "runtime_membrane_decision_ref": {"type": "string"}
      }
    },
    "decision": {"type": "string", "enum": ["uphold", "reverse", "remand", "modify", "emergency_freeze", "policy_change_required", "no_action"]},
    "basis_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constitutional_floor_ref", "charter_clause_refs"],
      "properties": {
        "constitutional_floor_ref": {"type": "string", "minLength": 3},
        "charter_clause_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "anomaly_signal_refs": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "affected_policy_refs": {"type": "array", "items": {"type": "string", "minLength": 3}}
      }
    },
    "ordered_remediation_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 3}
    },
    "rationale_text": {"type": "string", "minLength": 3},
    "status": {"type": "string", "enum": ["open", "decided", "remanded", "closed", "superseded"]},
    "created_at": {"type": "string", "format": "date-time"},
    "decided_at": {"type": "string", "format": "date-time"}
  }
}
