{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alexandrian-academy://schemas/stewarded-learning-artifact.schema.json",
  "title": "StewardedLearningArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header",
    "artifact_id",
    "artifact_type",
    "title",
    "stewardship_status",
    "primary_keeper_ref",
    "evidence_bundle_refs",
    "policy_snapshot_refs",
    "review_interval_days",
    "last_reviewed_at",
    "succession"
  ],
  "properties": {
    "header": {
      "$ref": "alexandrian-academy://schemas/universal-header.schema.json"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^sla_[a-zA-Z0-9_-]+$"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "curriculum_plan",
        "unit_map",
        "assessment_plan",
        "evidence_bundle",
        "lesson_object",
        "knowledge_lineage_note"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "stewardship_status": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "needs_review",
        "contested",
        "handoff_pending",
        "orphaned",
        "retired",
        "archived"
      ]
    },
    "primary_keeper_ref": {
      "type": "string",
      "minLength": 1
    },
    "successor_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "mentor_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "apprentice_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "evidence_bundle_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "curriculum_object_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "jurisdiction_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "pedagogy_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "accessibility_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "policy_snapshot_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "changeset_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "review_interval_days": {
      "type": "integer",
      "minimum": 1
    },
    "last_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "projection_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_uses", "disallowed_uses"],
      "properties": {
        "allowed_uses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "disallowed_uses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "succession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "requires_review"],
      "properties": {
        "posture": {
          "type": "string",
          "enum": ["defined", "missing", "handoff_pending", "emergency_only"]
        },
        "successor_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": []
        },
        "requires_review": {
          "type": "boolean"
        },
        "abandonment_threshold_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "non_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    }
  }
}
